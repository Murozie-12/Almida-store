rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ganti dengan UID akun admin Firebase Authentication, sama seperti firebase-config.js.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'YFfLMVGc7MUFTDlBVrzYNQzH9lI3';
    }

    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','category','price','description','promo','active','soldOut','updatedAt'])
        && d.keys().hasAll(['name','category','price','description','promo','active','soldOut','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.category is string && d.category in ['Telkomsel','Indosat','XL','AXIS','Tri','Smartfren','Pulsa','Produk Digital','By.U']
        && d.price is number && d.price > 0 && d.price <= 100000000
        && d.description is string && d.description.size() <= 300
        && d.promo is bool && d.active is bool && d.soldOut is bool
        && d.updatedAt is timestamp;
    }

    function validPromo() {
      let d = request.resource.data;
      return d.keys().hasOnly(['active','title','text','btn','updatedAt'])
        && d.keys().hasAll(['active','title','text','btn','updatedAt'])
        && d.active is bool
        && d.title is string && d.title.size() <= 80
        && d.text is string && d.text.size() <= 300
        && d.btn is string && d.btn.size() <= 30
        && d.updatedAt is timestamp;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && validProduct();
      allow update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }

    // Promo banner yang bisa diatur admin dari panel.
    match /settings/promo {
      allow read: if true;
      allow write: if isAdmin() && validPromo();
    }

    // Semua koleksi lain tertutup, termasuk orders dan users.
    match /{document=**} { allow read, write: if false; }
  }
}
